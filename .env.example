# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/pr_load_balancer

# GitHub OAuth (create at https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# GitHub Webhook Secret (set in repo webhook settings)
GITHUB_WEBHOOK_SECRET=

# Session
SESSION_SECRET=change-me-to-a-random-string

# GitHub Personal Access Token (for requesting reviews via API)
GITHUB_TOKEN=
